{
  "$defs": {
    "TaskAssignment": {
      "additionalProperties": false,
      "description": "A solver decision; all derived state is intentionally excluded.",
      "properties": {
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "window_id": {
          "minLength": 1,
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "start_s",
        "window_id"
      ],
      "title": "TaskAssignment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "solver_name": {
      "minLength": 1,
      "title": "Solver Name",
      "type": "string"
    },
    "tasks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskAssignment"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "solver_name"
  ],
  "title": "Schedule",
  "type": "object"
}
